{
  "expo": {
    "name": "Mezzo Passo",
    "slug": "mezzo-passo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F9FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "it.mezzopasso.app"
    },
    "android": {
      "package": "it.mezzopasso.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mezzo Passo usa le tue foto per impostare l'immagine del profilo."
        }
      ]
    ]
  }
}
